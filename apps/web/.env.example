# apps/web variable NAMES only. Copy to apps/web/.env.local for local overrides.
# Anything prefixed NEXT_PUBLIC_ is shipped to browsers: never put keys or secrets behind it
# (scripts/check-secrets.mjs enforces this).

# Where the Next.js server proxies /api/* (server-side only). Read at BUILD time for the
# /api rewrite and at runtime for server-side fetches. Default: http://127.0.0.1:8787
API_BASE_URL=
