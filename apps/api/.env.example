# apps/api environment variable NAMES. Copy to apps/api/.env for local development
# (loaded automatically outside production). Never commit values.
# Nothing here is required: with no values the API uses embedded PGlite and sign-in is disabled.

# Public origin of the website; OAuth callbacks are <APP_ORIGIN>/api/auth/<provider>/callback
APP_ORIGIN=
API_PORT=

# Database: set DATABASE_URL for Postgres (required in production). Unset → embedded PGlite in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=

# Optional monthly run limit per workspace for the quota hooks (unset = unlimited; nothing is charged)
RUN_QUOTA_PER_MONTH=

# OAuth (owner-registered apps; see docs/auth-setup.md). A provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Later milestones (not read yet)
# MODEL_PROVIDER=
# HOSTED_MODEL_API_KEY=
# BYOK_KEK_ID=
# BILLING_PROVIDER=
# BILLING_SECRET_KEY=
