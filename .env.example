# AgentFlow environment variable NAMES. Copy to .env and fill locally; never commit values.
# Session 1 needs none of these — the demo runs on bundled mock data.

# --- API (apps/api) ---
API_PORT=
# Postgres connection string (M3)
DATABASE_URL=

# --- Auth (M4, owner-registered OAuth apps) ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Models (M5/M6) — server-only, never NEXT_PUBLIC_ ---
# Defaults to the fake provider when unset.
MODEL_PROVIDER=
HOSTED_MODEL_API_KEY=
BYOK_KEK_ID=

# --- Billing (M13, owner-chosen vendor) ---
BILLING_PROVIDER=
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
